{
  "name": "jellygram",
  "version": "1.0.0",
  "description": "A self-hosted Telegram bot and Mini App for managing and uploading media to Jellyfin, with a private per-user library for every person you share the server with.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "init": "node scripts/init-env.mjs",
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "start:api": "node dist/api/server.js",
    "prestart:api": "node scripts/require-build.mjs dist/api/server.js",
    "start:bot": "node dist/bot/index.js",
    "prestart:bot": "node scripts/require-build.mjs dist/bot/index.js",
    "start:worker": "node dist/worker/index.js",
    "prestart:worker": "node scripts/require-build.mjs dist/worker/index.js",
    "migrate": "node dist/scripts/migrate.js",
    "premigrate": "node scripts/require-build.mjs dist/scripts/migrate.js",
    "admin:create": "node dist/scripts/create-admin.js",
    "preadmin:create": "node scripts/require-build.mjs dist/scripts/create-admin.js",
    "jellyfin:bootstrap": "node dist/scripts/jellyfin-bootstrap.js",
    "jellyfin:audit": "node dist/scripts/jellyfin-audit.js",
    "test": "node --test --experimental-test-module-mocks dist-tests/tests/*.test.js",
    "build:tests": "tsc -p tsconfig.tests.json",
    "test:e2e": "npm run build:tests && node dist-tests/tests/pipeline.e2e.js",
    "check": "tsc -p tsconfig.json --noEmit",
    "setup": "node dist/scripts/setup.js",
    "presetup": "node scripts/require-build.mjs dist/scripts/setup.js",
    "test:dashboard": "node tests/dashboard.e2e.mjs",
    "test:responsive": "node tests/responsive.e2e.mjs",
    "test:http": "node tests/http-assets.e2e.mjs",
    "test:all": "npm run build && npm run build:tests && npm test && npm run test:frontend && npm run test:e2e && npm run test:multipart && npm run test:mtproto && npm run test:recovery && npm run test:uploader && npm run test:http && npm run test:setup",
    "telegram:logout": "node dist/scripts/telegram-logout.js",
    "telegram:verify": "node dist/scripts/telegram-verify.js",
    "botapi:up": "docker compose -f docker-compose.botapi.yml up -d",
    "botapi:down": "docker compose -f docker-compose.botapi.yml down",
    "botapi:logs": "docker compose -f docker-compose.botapi.yml logs -f --tail=100",
    "test:setup": "node tests/setup-prompts.e2e.mjs",
    "test:multipart": "npm run build:tests && node dist-tests/tests/multipart.e2e.js",
    "upload:token": "node dist/scripts/upload-token.js",
    "upload": "node uploader/jellygram-upload.mjs",
    "test:uploader": "npm run build:tests && node tests/uploader.e2e.mjs",
    "telegram:mtproto:setup": "node dist/scripts/mtproto-setup.js",
    "telegram:mtproto:status": "node dist/scripts/mtproto-status.js",
    "test:mtproto": "npm run build:tests && node dist-tests/tests/mtproto.e2e.js",
    "media:repair": "node dist/scripts/repair-permissions.js",
    "media:reap": "node dist/scripts/reap.js",
    "jellyfin:reverify": "node dist/scripts/jellyfin-reverify.js",
    "upload:diagnose": "node dist/scripts/upload-diagnose.js",
    "test:recovery": "npm run build:tests && node dist-tests/tests/failure-recovery.e2e.js",
    "db:backup": "node dist/scripts/backup-db.js",
    "test:frontend": "node --test tests/frontend-ui.test.mjs tests/frontend-css.test.mjs tests/miniapp-ui.test.mjs",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f --tail=100 postgres"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "grammy": "^1.46.0",
    "helmet": "^8.3.0",
    "pg": "^8.23.0",
    "pino": "^9.14.0",
    "teleproto": "^1.229.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.1",
    "@types/pg": "^8.23.1",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.3"
  },
  "license": "MIT",
  "keywords": [
    "telegram",
    "telegram-bot",
    "telegram-mini-app",
    "jellyfin",
    "media-server",
    "self-hosted",
    "media-management",
    "file-upload",
    "mtproto",
    "postgresql",
    "typescript",
    "nodejs"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NahomHabtamuNSC/jellygram.git"
  },
  "bugs": {
    "url": "https://github.com/NahomHabtamuNSC/jellygram/issues"
  },
  "homepage": "https://github.com/NahomHabtamuNSC/jellygram#readme"
}
