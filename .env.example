# =============================================================================
# JellyGram — example configuration
# =============================================================================
#
#   cp .env.example .env      then edit, or run `npm run setup` for a guided
#                             version that prompts for each secret without
#                             echoing it to the terminal.
#
# Never commit .env. It is in .gitignore for a reason: it holds every secret
# this application has.
#
# Layout of this file:
#
#   1. REQUIRED             — the application will not start without these
#   2. Telegram             — bot, admin chat, Mini App
#   3. Jellyfin             — server addresses and API key
#   4. Storage              — where media lives and who may read it
#   5. Large files          — local Bot API server, direct uploader, MTProto
#   6. Metadata (TMDB)      — optional but strongly recommended
#   7. Dashboard & security — port, session, cookies, proxy
#   8. Worker & queue       — concurrency, retries, progress
#   9. Backups              — nightly dumps and their retention
#  10. Logging
#  11. Development only     — values you would never set in production
#
# Every value below is a default, and every default is safe to leave alone
# unless the comment says otherwise. Every setting is declared in
# src/config/index.ts and documented here, so this file and that file are the
# complete configuration surface.
#
# One variable is deliberately absent: JELLYFIN_ADMIN_PASSWORD. It lets
# `npm run jellyfin:bootstrap` run unattended, is used for a single call, and
# is read from the environment on purpose so that a live Jellyfin
# administrator password never has to be written to disk. See docs/jellyfin.md.


# =============================================================================
# 1. REQUIRED
# =============================================================================
#
# Four values. The process exits with status 78 (EX_CONFIG) and a list of what
# was wrong if any of them is missing or malformed.

# --- Database ----------------------------------------------------------------
# A PostgreSQL 14+ connection string for a database this application owns.
# See docs/database.md for creating the role and the database.
DATABASE_URL=postgresql://jellygram:your_database_password@127.0.0.1:5432/jellygram

# Only if you use the bundled docker-compose.yml to run PostgreSQL
# (`npm run db:up`). These initialise the container the first time it starts;
# DATABASE_URL must then agree with them, and the port defaults to 55432 so it
# cannot collide with a PostgreSQL already on the host:
#   DATABASE_URL=postgresql://jellygram:<POSTGRES_PASSWORD>@127.0.0.1:55432/jellygram
# Changing them later does not change an existing volume — the credentials are
# baked in when the data directory is first created.
POSTGRES_USER=jellygram
POSTGRES_PASSWORD=
POSTGRES_DB=jellygram
POSTGRES_PORT=55432

# --- Dashboard session key ---------------------------------------------------
# Signs the admin dashboard's session cookies. At least 16 characters; use far
# more. Generate one with:
#   openssl rand -base64 48
# Changing it signs every administrator out. It is not a password — never reuse
# a password here.
ADMIN_SESSION_SECRET=

# --- Telegram bot ------------------------------------------------------------
# From @BotFather → /newbot. Use a bot dedicated to this application; anyone
# holding this token controls the bot completely.
# The API and worker start without it; the bot process exits cleanly, saying so.
TELEGRAM_BOT_TOKEN=

# --- Jellyfin ----------------------------------------------------------------
# An API key from Jellyfin → Dashboard → API Keys, or created for you by
#   npm run jellyfin:bootstrap
# Without it the application cannot create libraries or enforce per-user access.
JELLYFIN_API_KEY=


# =============================================================================
# 2. Telegram
# =============================================================================

# How this deployment refers to itself: the dashboard's browser title and the
# heading inside the Telegram Mini App. Cosmetic, but it is the one string
# every user of your instance reads.
APP_NAME=JellyGram

# Telegram's public Bot API, or your own telegram-bot-api server running with
# --local. The public API refuses to hand a bot any file over 20 MB; a local
# server raises that to 2000 MB. See section 5 and docs/large-files.md.
TELEGRAM_API_ROOT=https://api.telegram.org
TELEGRAM_LOCAL_MODE=false

# Chat id that receives health alerts and administrative notifications: disk
# filling up, backups failing, Jellyfin rejecting its API key, repeated upload
# failures.
#
# Leave it empty and all of that is still detected and then discarded. The
# dashboard reports the gap as a warning on its Health page and the worker logs
# every alert it drops, so an empty value is a choice rather than a surprise.
#
# To find yours: send /start to your bot. The reply ends with your Telegram ID.
TELEGRAM_ADMIN_CHAT_ID=

# --- Waiting on the local Bot API server ------------------------------------
#
# Only relevant with TELEGRAM_LOCAL_MODE=true. In --local mode getFile does not
# answer until the server has fetched the whole file from Telegram, which for a
# multi-gigabyte file is many minutes. The request is polled rather than waited
# on, because the server keeps downloading after a client disconnects.
#
# The budget for one file is derived from its size and MIN_BYTES_PER_SEC,
# floored at the per-request timeout and capped at MAX_WAIT_SEC. The default
# rate is deliberately pessimistic; measure your own link before lowering the
# ceiling, because the cost of guessing high is a spurious timeout on a real
# upload and the cost of guessing low is only a longer wait before giving up.
TELEGRAM_GETFILE_TIMEOUT_SEC=60
TELEGRAM_GETFILE_POLL_SEC=15
TELEGRAM_GETFILE_MIN_BYTES_PER_SEC=307200
TELEGRAM_GETFILE_MAX_WAIT_SEC=14400
# How often the server-side fetch is sampled for progress. Independent of the
# poll interval, because a poll blocks for up to a minute before it fails.
TELEGRAM_PROGRESS_TICK_MS=2000

# --- Telegram Mini App -------------------------------------------------------
#
# A second interface — your own library with posters, an upload button, live
# progress — running inside Telegram. Same accounts, same pipeline, same
# private Jellyfin libraries.
MINIAPP_ENABLED=true

# The https URL Telegram opens. It must be reachable by the phone and it must
# be https: Telegram refuses plain http and refuses bare LAN addresses. Leave
# it empty and no menu button is registered, which is better than registering
# one that cannot work.
#
# Options, in rising order of exposure — see docs/networking.md:
#   • a reverse proxy with a Let's Encrypt certificate on a domain you own
#   • Cloudflare Tunnel or a similar outbound tunnel
#   • `tailscale funnel --bg --https=8443 http://127.0.0.1:8300`
MINIAPP_URL=

# How long a signed initData blob stays acceptable. Telegram signs it once when
# the app opens and does not refresh it while it stays open, so this is really
# "how long may one sitting last". A day is Telegram's own norm; shorten it if
# your users' phones are less trusted than their laptops.
MINIAPP_MAX_AGE_SEC=86400


# =============================================================================
# 3. Jellyfin
# =============================================================================

# How THIS SERVER reaches Jellyfin. Usually loopback, because Jellyfin normally
# runs on the same machine.
JELLYFIN_URL=http://127.0.0.1:8096

# How a PERSON'S BROWSER reaches Jellyfin — which is not the same address.
# Handing a phone `http://127.0.0.1:8096` points it at the phone. This is the
# address the Mini App offers as "Open Jellyfin" on the local network.
# Leave empty when the two genuinely coincide.
JELLYFIN_PUBLIC_URL=http://192.0.2.10:8096

# Two more doors the Mini App can measure its way through, both optional and
# both https. "Open Jellyfin" probes them in the order tailscale → lan →
# internet and opens the first that answers, so a phone at home takes the fast
# local route and the same phone elsewhere still works.
#   • TAILSCALE: a private-network address (Tailscale, WireGuard, ZeroTier…)
#   • INTERNET:  a genuinely public address — read docs/networking.md first
JELLYFIN_TAILSCALE_URL=
JELLYFIN_INTERNET_URL=

# Optional prefix for the libraries this application creates, e.g. "TG" gives
# "TG Movies - alice". Useful when Jellyfin also holds libraries you curate
# yourself and you want the two sets visibly separate.
JELLYFIN_LIBRARY_PREFIX=

# How long to wait for Jellyfin to surface a newly added item before reporting
# the upload as unverified. A large library scans more slowly.
JELLYFIN_VERIFY_TIMEOUT_SEC=180
JELLYFIN_VERIFY_INTERVAL_SEC=10


# =============================================================================
# 4. Storage
# =============================================================================
#
# MEDIA_ROOT is the only one you must set; the other four default to sensible
# places beneath it. Point it at a filesystem with room for your library —
# not at the project directory.
MEDIA_ROOT=/srv/media
MOVIES_ROOT=/srv/media/movies
TV_ROOT=/srv/media/tv
# Scratch space for in-flight downloads. MUST be on the same filesystem as
# MEDIA_ROOT, so that filing a finished download is a rename rather than a copy
# of several gigabytes.
DOWNLOAD_TMP_DIR=/srv/media/.incoming
# Where files land when identification fails. Never deleted automatically.
QUARANTINE_DIR=/srv/media/.quarantine

# The group given read access to the media tree so Jellyfin can index it, and
# the modes applied to what this application creates. `jellyfin` is the group
# the Debian/Ubuntu Jellyfin package creates; check yours with `id jellyfin`.
# Set MEDIA_GROUP empty to disable group management entirely (single-user
# machines, containers running everything as one uid).
MEDIA_GROUP=jellyfin
MEDIA_DIR_MODE=0750
MEDIA_FILE_MODE=0640

# How long a scratch file in DOWNLOAD_TMP_DIR must sit untouched before the
# worker's reaper deletes it. A file still referenced by an unfinished upload,
# multi-part session or MTProto job is never deleted whatever its age, so this
# only governs orphans: files left by a job that failed, was cancelled, or was
# killed mid-download. It is therefore also the floor on how long an ingestion
# may stall and still resume. QUARANTINE_DIR is never touched.
DOWNLOAD_TMP_GRACE_HOURS=24

# Largest single file accepted. 2000 MB is the local Bot API server's ceiling;
# Telegram does not serve a bot more than that whatever you put here.
MAX_FILE_SIZE_BYTES=2097152000
# Refuse a download that would leave less than this free. 10 GB.
MIN_FREE_DISK_BYTES=10737418240
# Extra headroom required on top of the file's own size. 2 GB.
DISK_SAFETY_MARGIN_BYTES=2147483648

# Everything else is refused with a clear message, including subtitle files.
ALLOWED_EXTENSIONS=mp4,mkv,avi,mov


# =============================================================================
# 5. Large files
# =============================================================================
#
# Three independent routes past Telegram's bot limits. Each is optional; enable
# only the ones you need. docs/large-files.md explains when each applies.

# --- 5a. Local Bot API server (files 20 MB – 2000 MB, sent to the bot) -------
#
# Runs Telegram's own telegram-bot-api in --local mode, which lifts the 20 MB
# ceiling and makes getFile return a path on this machine instead of a URL.
#   docker compose -f docker-compose.botapi.yml up -d
#
# API_ID / API_HASH come from https://my.telegram.org → API development tools.
# They are ACCOUNT credentials, not bot credentials, and cannot be derived from
# the bot token. They are also what MTProto ingestion (5c) uses.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# The host directory bind-mounted into the container, and the two sides of that
# mount: getFile returns a path as the CONTAINER sees it, and the worker runs
# on the host. Leave HOST_ROOT equal to FILE_ROOT when telegram-bot-api runs
# directly on the host rather than in a container.
# BOTAPI_DATA_DIR is read by docker compose; the other two are read by this
# application. A relative TELEGRAM_LOCAL_HOST_ROOT resolves against the project
# directory, not against whatever directory a service happens to start in.
BOTAPI_DATA_DIR=./botapi-data
TELEGRAM_LOCAL_FILE_ROOT=/var/lib/telegram-bot-api
TELEGRAM_LOCAL_HOST_ROOT=./botapi-data

# The container runs as this uid/gid so downloaded files are owned by the
# service user and the worker can move and remove them.
#   BOTAPI_UID: `id -u` for the user running this application
#   BOTAPI_GID: the MEDIA GROUP's gid (`getent group jellyfin`), NOT the user's
#               own group — a downloaded file is *renamed* into the library and
#               keeps the group it was created with, so creating it with the
#               media group up front is what makes it readable by Jellyfin.
BOTAPI_UID=1000
BOTAPI_GID=1000
BOTAPI_VERBOSITY=1

# --- 5b. Direct uploader (any file, from a machine you control) --------------
#
# uploader/jellygram-upload.mjs is a single dependency-free file you copy to
# wherever your media lives. It bypasses Telegram entirely and talks to this
# server's ingest endpoint.
#
# Files at or below SINGLE_MAX go in one request; above it the uploader splits
# automatically into PART_BYTES pieces. PART_MAX is a hard cap on any single
# request body the server will accept.
UPLOAD_SINGLE_MAX_BYTES=2147483648
UPLOAD_PART_BYTES=1073741824
UPLOAD_PART_MAX_BYTES=2147483648

# --- Multi-part reassembly (both the uploader and hand-split Telegram sends) -
#
# The ceiling for the ASSEMBLED result, not for one part.
MAX_ASSEMBLED_FILE_BYTES=5368709120
# A session with no new part for this long is assembled if complete, or expired
# and its parts deleted if not.
MULTIPART_IDLE_MINUTES=30
# Refuse a session that would need more pieces than this.
MULTIPART_MAX_PARTS=64
# How long a permanently failed session keeps its uploaded parts, so a retry
# need not re-upload gigabytes.
MULTIPART_FAILED_RETENTION_HOURS=72

# --- 5c. MTProto ingestion (forwarded media over 2000 MB) --------------------
#
# Lets the server fetch media you FORWARD to the bot that the Bot API is too
# small to carry, using your own Telegram account rather than the bot. Telegram
# will not serve a bot a file above 2000 MB; a user account has no such limit
# on media it can already see.
#
# Off unless enabled AND authenticated:
#   npm run telegram:mtproto:setup
# It reuses TELEGRAM_API_ID / TELEGRAM_API_HASH above.
TELEGRAM_MTPROTO_ENABLED=false

# The session file this creates. Anyone holding it can act as your Telegram
# account until you revoke it (Telegram → Settings → Devices). Mode 0600, and
# .gitignore already excludes it. Default: <project>/.mtproto-session
TELEGRAM_MTPROTO_SESSION_PATH=

# Ceiling for a file fetched this way. 5 GiB.
MTPROTO_MAX_FILE_BYTES=5368709120
# Streamed chunk size; bounds memory use. 1 MiB.
MTPROTO_CHUNK_BYTES=1048576
# How many recent messages of your bot dialog to search when a forward carries
# no usable origin id.
MTPROTO_SEARCH_DEPTH=60
MTPROTO_MAX_ATTEMPTS=3
# Longest gap allowed between two chunks before a download is treated as
# stalled and retried. Bounds a stall, not the transfer: a slow but progressing
# download resets it on every chunk.
MTPROTO_STALL_TIMEOUT_SEC=120
# Restrict MTProto ingestion to one Telegram id — the account that authenticated
# above. Blank allows any registered user, which only makes sense if everyone
# registered shares that account.
MTPROTO_OWNER_TELEGRAM_ID=


# =============================================================================
# 6. Metadata (TMDB)
# =============================================================================
#
# Optional. Without a key the filename parser still works; with one, titles,
# years, season/episode numbers and posters are confirmed against TMDB, and
# far fewer uploads end up in the review queue.
# Free key: https://www.themoviedb.org/settings/api (v3 key or v4 read token)
TMDB_API_KEY=
TMDB_LANGUAGE=en-US


# =============================================================================
# 7. Dashboard & security
# =============================================================================

NODE_ENV=production

ADMIN_PORT=8300
# 127.0.0.1 keeps the dashboard on loopback only — the right default if you
# reach it through a reverse proxy or an SSH tunnel. Use 0.0.0.0 only when you
# understand what else can reach this port; see docs/networking.md.
ADMIN_BIND_HOST=127.0.0.1
ADMIN_SESSION_TTL_HOURS=12

# Set to true ONLY when the dashboard is genuinely served over HTTPS. On plain
# HTTP a Secure cookie is never sent back, so sign-in silently fails. It also
# controls whether the CSP sends upgrade-insecure-requests.
ADMIN_COOKIE_SECURE=false

# Behind a TLS-terminating reverse proxy, set true so the forwarded client
# address and protocol are believed — from loopback only, which is where such a
# proxy connects from. Without it every request appears to come from 127.0.0.1,
# so the login rate limiter counts the whole world as one client and the audit
# log records the proxy instead of the caller.
TRUST_PROXY=false

# How long a single HTTP request to the admin/upload API may take. Node
# defaults requestTimeout to 300s, which silently kills any upload longer than
# five minutes — a 2 GiB single-piece upload over a slow link is one. Headers
# stay on a short timeout, so a slowloris attack is still bounded.
API_REQUEST_TIMEOUT_SEC=14400
API_HEADERS_TIMEOUT_SEC=60


# =============================================================================
# 8. Worker & queue
# =============================================================================

# Drain mode: accept work but let no worker claim it. Newly enqueued jobs are
# dated far ahead, so nothing is lost — the work simply waits. Useful before a
# migration or a restart.
QUEUE_PAUSED=false

# Slots reserved for long transfers and for everything else. The point of the
# split is not throughput: it is that a short upload is never stuck behind two
# long ones. Keep them small on modest hardware — more parallel transfers on
# one spinning disk make every one of them slower.
WORKER_LARGE_CONCURRENCY=1
WORKER_SMALL_CONCURRENCY=2
# At or above this, an upload counts as a long transfer. 512 MiB.
WORKER_LARGE_UPLOAD_BYTES=536870912
# Reported on the settings page for compatibility; the two lanes above are what
# actually decide capacity.
WORKER_CONCURRENCY=2

WORKER_POLL_INTERVAL_MS=2000
# How often queued uploads are told their position in the queue.
QUEUE_REFRESH_INTERVAL_MS=10000
# How often health is re-checked. Alerts fire on change, not on this tick.
HEALTH_CHECK_INTERVAL_MS=300000

JOB_MAX_ATTEMPTS=3
JOB_RETRY_BACKOFF_MS=30000
# Ceiling on the exponential retry delay.
JOB_RETRY_MAX_BACKOFF_MS=1800000

# Minimum gap between Telegram progress message edits, and the smallest change
# in percent worth an edit. Telegram rate-limits message edits aggressively.
PROGRESS_EDIT_INTERVAL_MS=5000
PROGRESS_EDIT_MIN_DELTA=2

# Connections in the PostgreSQL pool, per process. Three processes share the
# server, so the real ceiling is roughly 3 × this.
DB_POOL_MAX=6


# =============================================================================
# 9. Backups
# =============================================================================
#
# `npm run db:backup` writes a gzipped plain-SQL pg_dump. deploy/ ships a timer
# that runs it nightly. Media is NOT backed up — it is ordinary files, so use
# whatever you already use.
# Default: <project>/backups
BACKUP_DIR=
BACKUP_RETENTION_DAYS=14
# After this long, the dashboard calls the newest backup stale and health warns.
BACKUP_STALE_HOURS=36


# =============================================================================
# 10. Logging
# =============================================================================

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Default: <project>/logs. Files are per-service and per-day.
LOG_DIR=
LOG_TO_FILE=true


# =============================================================================
# 11. Development only
# =============================================================================
#
# Do not set these in production. They are listed here so you know they exist.
#
#   NODE_ENV=development
#       Relaxes nothing security-relevant; it changes log formatting and is
#       reported on the dashboard's settings page.
#
#   ADMIN_BIND_HOST=0.0.0.0
#       Only while developing against a phone on the same LAN.
#
#   JELLYGRAM_TEST_DATABASE_NAME=jellygram_test
#       The scratch database the test suite creates and destroys. It is spliced
#       onto DATABASE_URL, so the tests need no second server and no second set
#       of credentials. The suite refuses to start if this ever equals the
#       database DATABASE_URL names. Override only if `jellygram_test` is taken.
#
#   MEDIA_ROOT / MOVIES_ROOT / TV_ROOT / DOWNLOAD_TMP_DIR / QUARANTINE_DIR
#       The test suite overrides all five to a scratch tree at .test-media/
#       before configuration is read. You never need to set them for tests.
#
# See docs/testing.md.
